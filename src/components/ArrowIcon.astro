---
interface Props {
  direction?: "right" | "down" | "external";
  size?: number;
}

const { direction = "right", size = 18 } = Astro.props;
const paths = {
  right: "M5 12h14m-5-5 5 5-5 5",
  down: "M12 5v14m-5-5 5 5 5-5",
  external: "M7 17 17 7m-8 0h8v8",
};
---

<svg
  aria-hidden="true"
  class="arrow-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
>
  <path d={paths[direction]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
