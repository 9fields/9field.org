---
import ArrowIcon from "./ArrowIcon.astro";
import { site } from "../data/site";
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__top">
      <div>
        <p class="site-footer__brand">九野 <span>9FIELD</span></p>
        <p class="site-footer__note">品牌、产品与技术门户</p>
      </div>
      <a href={site.corporateUrl} rel="external">公司主站 9field.cn <ArrowIcon direction="external" /></a>
    </div>
    <div class="site-footer__bottom">
      <p>© 2026 九野</p>
      <a href="#home">回到顶部 <ArrowIcon direction="right" /></a>
    </div>
  </div>
</footer>
