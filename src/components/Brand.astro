---
interface Props {
  inverted?: boolean;
}

import { site } from "../data/site";

const { inverted = false } = Astro.props;
---

<a class:list={["brand", { "brand--inverted": inverted }]} href="/" aria-label={`${site.companyName}（简称${site.shortName}）首页`}>
  <span class="brand__han">{site.shortName}</span>
  <span class="brand__latin">{site.latinTrademark}</span>
</a>
