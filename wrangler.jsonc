{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "9field-org",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "9field.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist"
  }
}
